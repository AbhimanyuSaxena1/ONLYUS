# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/onlyus

# JWT Authentication Secrets (Change in production!)
JWT_ACCESS_SECRET=onlyus_ultra_secure_access_token_secret_32chars_min
JWT_REFRESH_SECRET=onlyus_ultra_secure_refresh_token_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web Push VAPID Keys (Auto-generated in dev if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@onlyus.app

# Coturn / TURN Server Configuration (Optional, fallback to Google STUN)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
